WEATHER_DEFAULT_LATITUDE=23.2599
WEATHER_DEFAULT_LONGITUDE=77.4126
WEATHER_DATA_DIR=data
WEATHER_MODELS_DIR=models
WEATHER_DB_PATH=data/prediction_history.db
